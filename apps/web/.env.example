# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or Supabase recommended for cloud)
DATABASE_URL="postgresql://user:password@host:5432/engineering_copilot?sslmode=require"

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── AI Providers (at least one required) ─────────────────────────────────────
# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# Google AI (https://makersuite.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# Ollama (local — no key needed, just run `ollama serve`)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ─── Background Jobs (Inngest) ────────────────────────────────────────────────
# Get keys at https://app.inngest.com
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# ─── Storage (for PDF exports) ────────────────────────────────────────────────
# Vercel Blob (https://vercel.com/docs/storage/vercel-blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ─── Analytics (optional) ─────────────────────────────────────────────────────
POSTHOG_KEY="phc_..."
POSTHOG_HOST="https://app.posthog.com"
